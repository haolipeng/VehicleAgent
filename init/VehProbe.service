[Unit]
Description=VehProbe
Documentation=https://docs.fluentbit.io/manual/
Requires=network.target
After=network.target

[Service]
Type=simple
EnvironmentFile=-/etc/sysconfig/VehProbe
EnvironmentFile=-/etc/default/VehProbe
ExecStart=/usr/local/bin/VehProbe -c /etc/VehProbe/VehProbe.conf
Restart=always

[Install]
WantedBy=multi-user.target
